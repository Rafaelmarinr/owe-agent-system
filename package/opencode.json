{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "donna",
  "subagent_depth": 1,
  "share": "disabled",
  "enabled_providers": [
    "openai"
  ],
  "instructions": [
    "AGENTS.md",
    ".opencode/instructions/*.md"
  ],
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*wp-config.php": "ask",
      "*.pem": "deny",
      "*.key": "deny",
      "*credentials*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "edit": {
      "*": "ask",
      ".opencode/**": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny",
      ".owe/project-file-policy.json": "deny",
      "wp-admin/**": "deny",
      "wp-includes/**": "deny",
      "vendor/**": "deny",
      "wp-content/cache/**": "deny",
      "wp-content/uploads/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*credentials*": "deny"
    },
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git clean*": "deny",
      "git push*": "deny"
    },
    "external_directory": "deny",
    "doom_loop": "ask"
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "vendor/**",
      ".owe/logs/**",
      ".owe/runtime/**",
      "wp-content/cache/**",
      "wp-content/uploads/**",
      "wp-content/upgrade/**",
      "*.sql",
      "*.sql.gz"
    ]
  }
}
